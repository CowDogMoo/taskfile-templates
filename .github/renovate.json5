{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>CowDogMoo/renovate-config',
  ],
  customManagers: [
    {
      description: 'Update workflow env versions annotated with a "# renovate:" comment',
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      depTypeTemplate: 'renovate-annotation',
    },
  ],
  packageRules: [
    {
      description: 'GO_VERSION and PYTHON_VERSION envs are tracked by the shared preset; skip their annotations so they are not extracted twice',
      matchDepTypes: [
        'renovate-annotation',
      ],
      matchDepNames: [
        'go',
        'python',
      ],
      enabled: false,
    },
  ],
}
